# Pilih database: "postgres" atau "mysql"
DATABASE_TYPE=postgres

# Port server API (default 3001)
PORT=3001

# Izinkan request dari frontend di port ini (CORS)
FRONTEND_ORIGIN=http://localhost:8123

# ── PostgreSQL ───────────────────────────────────────────
PG_HOST=localhost
PG_PORT=5432
PG_DATABASE=bra_running_style
PG_USER=bra_app
PG_PASSWORD=bra_app_local

# ── MySQL / MariaDB ──────────────────────────────────────
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_DATABASE=bra_running_style
MYSQL_USER=bra_app
MYSQL_PASSWORD=bra_app_local
